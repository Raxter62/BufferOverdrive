# Railway / Supabase 環境變數範例：實際值請填在 Railway Variables，不要提交真正金鑰。
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SECRET_KEY=sb_secret_xxxxxxxxxxxxxxxxxxxxxx

# 若 Supabase 專案仍使用 legacy key，也可改用 SUPABASE_SERVICE_ROLE_KEY。
# SUPABASE_SERVICE_ROLE_KEY=your-legacy-service-role-key

# Gemini / LangChain LLM 設定：Boss 台詞會從後端讀取這些值。
GOOGLE_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-3-flash-preview

# 本機除錯時才設為 1；Railway 正式部署建議保持 0 或不設定。
FLASK_DEBUG=0
